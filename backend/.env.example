FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
# Local development can use SQLite. Vercel requires a persistent PostgreSQL URL.
DATABASE_URL=sqlite:///sneakzone.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only for local demo; never in production
SEED_ON_START=true
# Create initial admin on first seed (change immediately after first login)
ADMIN_EMAIL=admin@sneakzone.local
ADMIN_PASSWORD=ChangeMeAdmin123!
# Demo payment mode — no real gateway charged
PAYMENT_MODE=demo
FREE_DELIVERY_THRESHOLD=2999
STANDARD_DELIVERY_FEE=99
